{
  "name": "jsherlock",
  "version": "0.0.7",
  "description": "Find usernames across social-networks",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "test": "mocha -r ts-node/register ./test/*.spec.ts -t 6e4 --exit",
    "build": "tsc",
    "lint": "prettier --check 'src/**/*.ts' 'test/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'test/**/*.ts'",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/AungMyoKyaw/jsherlock.git"
  },
  "keywords": [
    "reconnaissance",
    "information-gathering",
    "username-checker",
    "osint",
    "social-media"
  ],
  "author": "Aung Myo Kyaw",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AungMyoKyaw/jsherlock/issues"
  },
  "homepage": "https://github.com/AungMyoKyaw/jsherlock#readme",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.5",
    "mocha": "^11.1.2",
    "prettier": "^3.5.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
